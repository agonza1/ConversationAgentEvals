{
  "name": "conversation-agent-evals",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "setup": "npm install && ./scripts/ensure-venv.sh apps/api/.venv apps/api/requirements.txt",
    "dev": "npm run check:env && node scripts/dev.js",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "apps/api/.venv/bin/python -m uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port ${API_PORT:-8000}",
    "dev:pipecat": "(test -x apps/pipecat/.venv/bin/python || ./scripts/ensure-venv.sh apps/pipecat/.venv apps/pipecat/requirements.txt) && apps/pipecat/.venv/bin/python -m uvicorn server:app --app-dir apps/pipecat --host 0.0.0.0 --port ${PIPECAT_PORT:-8110}",
    "build:web": "rm -rf apps/web/.next && npm --workspace apps/web run build",
    "start:web": "rm -rf apps/web/.next && npm --workspace apps/web run build && npm --workspace apps/web run start",
    "lint:web": "npm --workspace apps/web run lint",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:check": "node scripts/docker-parity-check.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:api:docker": "API_TEST_MODE=docker node scripts/test-api.mjs",
    "test:api:local": "API_TEST_MODE=local node scripts/test-api.mjs",
    "test:benchmark-smoke": "CHECK_ENV_ALLOW_EXAMPLE=1 npm run check:env && apps/api/.venv/bin/python scripts/benchmark_smoke.py",
    "test:voice-lab-proof": "./scripts/ensure-venv.sh apps/api/.venv apps/api/requirements.txt && apps/api/.venv/bin/python scripts/voice_lab_proof.py",
    "test:voice-lab-proof:acc": "./scripts/ensure-venv.sh apps/api/.venv apps/api/requirements.txt && apps/api/.venv/bin/python scripts/voice_lab_proof.py --acc-repo-root ../agentic-contact-center",
    "example:acc": "apps/api/.venv/bin/python scripts/agentic_contact_center_example.py",
    "example:acc:fixture": "apps/api/.venv/bin/python scripts/agentic_contact_center_example.py --input docs/examples/agentic-contact-center-run-fixture.json --skip-submit",
    "example:acc:fixture:run": "apps/api/.venv/bin/python scripts/agentic_contact_center_example.py --input docs/examples/agentic-contact-center-run-fixture.json",
    "install:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers npx playwright install chromium",
    "test:voice-proof": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers npx playwright test apps/web/tests/voice-proof.spec.ts --config apps/web/playwright.config.ts",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers npm --workspace apps/web run test:e2e",
    "test:e2e:browser": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers npm --workspace apps/web run test:e2e:browser",
    "check:env": "node scripts/check-env.mjs"
  },
  "overrides": {
    "postcss": "8.5.10",
    "protobufjs": "7.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0"
  }
}
