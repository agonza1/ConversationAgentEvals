# Minimal local demo environment
# Copy this file to .env before running npm run dev.
# Advanced Docker, live ASR, billing, auth, and provider keys live in docs/environment.md.

# Required for the blessed local demo and env smoke check.
PORT=3012
API_PORT=8025
PIPECAT_PORT=8110
# Only this operator-configured destination may be probed by the ACC readiness endpoint.
ACC_BASE_URL=http://127.0.0.1:8026
APP_ENV=development
# Set PRODUCTION=true to hide non-live testing controls such as text Q&A and simulated voice.
PRODUCTION=false

# Optional real built-in generalist voice flow. Services must be running locally.
RTC_ASR_BASE_URL=http://127.0.0.1:8080
KOKORO_BASE_URL=http://127.0.0.1:8880
KOKORO_TESTER_VOICE=af_heart
KOKORO_TARGET_VOICE=af_bella
# Native npm run dev reaches host Ollama on loopback. Docker Compose overrides
# this with COMPOSE_OLLAMA_BASE_URL (default http://host.docker.internal:11434).
OLLAMA_BASE_URL=http://127.0.0.1:11434
REFERENCE_OLLAMA_MODEL=gemma2:2b
# Keep the scenario tester independent; this default makes the sample voice run fully local.
# Replace with a GPT model only when OPENAI_API_KEY or Codex OAuth is configured.
REFERENCE_TESTER_LLM_MODEL=ollama/gemma2:2b
# npm run dev creates an ephemeral shared token when this is omitted.
REFERENCE_AGENT_INTERNAL_TOKEN=

# Optional: reuse the same browser URL when running Playwright against npm run dev.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3012
PLAYWRIGHT_REUSE_EXISTING_SERVER=1

# Opt in to live calls against the allowlisted public SignalWire demo.
CAE_ENABLE_SIGNALWIRE_HOLYGUACAMOLE=0
