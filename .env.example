# ConversationAgentEvals local environment

# Shared ports / service URLs
PORT=3012
API_PORT=8025
PIPECAT_PORT=8110
API_BASE_URL=http://localhost:8025
PIPECAT_SERVICE_URL=http://localhost:8110
NEXT_PUBLIC_API_BASE_URL=http://localhost:8025
NEXT_PUBLIC_PIPECAT_SERVICE_URL=http://localhost:8110

# Docker Compose database / worker defaults
POSTGRES_DB=conversation_agent_evals
POSTGRES_USER=cae
POSTGRES_PASSWORD=cae_local_password
POSTGRES_PORT=54329
DATABASE_URL=postgresql://cae:cae_local_password@localhost:54329/conversation_agent_evals
WORKER_POLL_INTERVAL_SECONDS=30

PLAYWRIGHT_BASE_URL=http://127.0.0.1:3012
PLAYWRIGHT_REUSE_EXISTING_SERVER=1

# Models / providers
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_RESPONSES_MODEL=gpt-4.1-mini

# Firebase Auth / Google Cloud project scaffolding
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Billing / usage gates
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
BUSINESS_CONTACT_URL=

# Runtime tuning
REALTIME_REQUEST_TIMEOUT_MS=5000
APP_ENV=development
# Set PRODUCTION=true to hide non-live testing controls such as text Q&A and simulated voice.
PRODUCTION=false
