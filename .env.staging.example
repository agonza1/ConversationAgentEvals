# Hosted staging: no operator model, speech, telephony, or GPT credentials.
APP_ENV=staging
# Explicitly require Firebase; when unset, nonempty Firebase web variables enable it automatically.
# With neither the mode nor Firebase web variables set, the original shared local mode is used.
CAE_AUTH_MODE=firebase
CAE_PUBLIC_ORIGIN=https://REPLACE_WITH_WEB_ORIGIN
DATABASE_URL=postgresql://REPLACE_WITH_SECRET

# Public Firebase web configuration, from Project settings > Your apps.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Secret Manager value. Generate once with Fernet.generate_key(); preserve across releases.
CAE_CREDENTIAL_ENCRYPTION_KEY=
# Firebase Admin uses the deployment service account (Application Default Credentials).
# For a local hosted-mode test only, use APP_ENV=development and a bounded service-account file.

# Reviews remain user-triggered and require the current user's saved API key.
ASSERT_UPSTREAM_JUDGE_ENABLED=1
ASSERT_JUDGE_MODEL=openai/gpt-4.1-mini
ASSERT_JUDGE_ALLOWED_MODELS=openai/gpt-4.1-mini
ASSERT_JUDGE_MAX_N=1
ASSERT_JUDGE_MAX_CONCURRENT=2
SPEC_GENERATION_MODEL=gpt-4.1-mini
CHATGPT_PLAN_LOCAL_ENABLED=0
OPENAI_CODEX_IMPORT_HOME=0

# Shared SQL counters: fixed UTC windows, HTTP 429 + Retry-After on exhaustion.
CAE_REQUEST_RATE_PER_MINUTE=180
CAE_WRITE_RATE_PER_MINUTE=30
CAE_COMPUTE_RATE_PER_MINUTE=5
CAE_COMPUTE_RATE_PER_DAY=100
CAE_LOGIN_RATE_PER_MINUTE=20
CAE_MAX_REQUEST_BYTES=5242880

# Next.js server-side rewrite destination. Set at web image build time.
API_BASE_URL=https://REPLACE_WITH_API_ORIGIN
